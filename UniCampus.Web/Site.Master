<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="UniCampus.Web.SiteMaster" %>

<!DOCTYPE html>
<html lang="es">
<head runat="server">
    <meta charset="utf-8" />
    <title>UniCampus</title>
    <link href="Content/site.css" rel="stylesheet" />
</head>
<body>
    <form id="form1" runat="server">
        <header class="topbar">
            <div class="marca"><strong>UniCampus</strong><small>Sistema de Gestión Académica</small></div>
            <div class="usuario"><asp:Label ID="lblUsuario" runat="server" /></div>
        </header>
        <aside class="sidebar">
            <a href="Actividades.aspx" class="activo">Actividades Académicas</a>
            <asp:LinkButton ID="btnSalir" runat="server" OnClick="btnSalir_Click">Cerrar sesión</asp:LinkButton>
        </aside>
        <main class="contenido">
            <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </main>
    </form>
</body>
</html>
